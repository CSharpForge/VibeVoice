# LiveKit OSS config (see https://github.com/livekit/livekit/blob/master/config-sample.yaml)
# API keys come from the LIVEKIT_KEYS environment variable, not this file.

port: 7880          # signalling; Nginx Proxy Manager terminates TLS and forwards here
# Privacy: warnings and errors only, so routine join/leave events (with client IPs)
# are not written to the container log.
logging:
  level: warn

rtc:
  tcp_port: 7881    # ICE/TCP fallback, must be reachable directly (not via the proxy)
  udp_port: 7882    # single UDP mux port, must be reachable directly
  # Fixed addresses: no STUN-based discovery of our own IP.
  use_external_ip: false
  node_ip: 203.0.113.10          # <-- your server's PUBLIC IP (placeholder)
  advertise_internal_ip: true    # also offer the LAN address so LAN clients skip NAT hairpin
  # Phase 1 of self-hosted STUN: point clients at our own host instead of the
  # built-in Twilio/Google defaults. Nothing listens on 3478 until phase 2
  # (embedded TURN, needs the lk.example.com certificate), so no STUN candidates
  # are produced for now; the server's fixed public IP still works.
  stun_servers:
    - lk.example.com:3478

# Phase 2: LiveKit's embedded TURN (also answers STUN on udp_port). Fully self-hosted.
# To enable, in this order:
#   1. On the server, in /opt/vibevoice/.env set NPM_LETSENCRYPT_DIR to NPM's letsencrypt
#      folder (the one NPM mounts at /etc/letsencrypt) and NPM_CERT_ID to the
#      lk.agiledeck.org folder under live/ (e.g. npm-8). Only that cert is mounted.
#   2. Open and forward 3478/udp and 5349/tcp to this server.
#   3. Uncomment the block below, set npm-N to NPM_CERT_ID, then run deploy/deploy.sh.
# LiveKit reads the certificate only at startup: after NPM renews it (about every
# 60 days) run `docker compose restart livekit` on the server.
#
# turn:
#   enabled: true
#   domain: lk.agiledeck.org
#   cert_file: /certs/live/npm-N/fullchain.pem
#   key_file: /certs/live/npm-N/privkey.pem
#   udp_port: 3478
#   tls_port: 5349
